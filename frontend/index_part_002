    // 网络失败时回退本地
    var data2=Array.isArray(dataCache[sceneId])?dataCache[sceneId]:[];
    dataCache[sceneId]=data2.filter(function(x){ return String(x.id)!==String(id); });
    renderDetail(sceneId);
    renderHome();
    alert('网络异常，已离线删除');
  }
}

