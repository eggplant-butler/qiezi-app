async function login(){
  var p = document.getElementById('pwdI').value;
  if(!p) return;
  try {
    var r = await fetch('/api/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ password: p })
    });
